Cell["\<\
Recommended fast strategy for known analytic branches. This samples the \
all-order invariant branches directly and returns a normal search object. For \
N=3 use only the hypercubic branch; for N=4 use both hypercubic and simplex; \
for N>=5 these are universal known branches but may not be complete.\
\>", "Text",ExpressionUUID->"1eb47e7d-93a1-41dd-b787-829baa97793e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"knownBranches", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"Nflavours", " ", "==", " ", "3"}], ",", " ", 
     RowBox[{"{", "\"\<Hypercubic\>\"", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Hypercubic\>\"", ",", " ", "\"\<Simplex\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"search", " ", "=", " ", 
   RowBox[{"FastKnownBranchInvariantSearch", "[", "\n", "  ", 
    RowBox[{"model", ",", "\n", "  ", 
     RowBox[{"\"\<Branches\>\"", " ", "->", " ", "knownBranches"}], ",", "\n",
      "  ", 
     RowBox[{"\"\<CountPerBranch\>\"", " ", "->", " ", "250"}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<RandomRotations\>\"", " ", "->", " ", "True"}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<Seed\>\"", " ", "->", " ", "2026"}], ",", "\n", "  ", 
     RowBox[{"\"\<WorkingPrecision\>\"", " ", "->", " ", 
      "workingPrecision"}]}], "\n", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"4d77e940-f32d-4317-aaed-da26e35a84ee"],

Cell["\<\
Optional verification: evaluate the finite Lie-chain residual on a small \
number of sampled points. This is much faster than using the Lie-chain \
equations to search.\
\>", "Text",
 CellChangeTimes->{{3.989506756035302*^9, 
  3.989506757327017*^9}},ExpressionUUID->"726f4ba5-0701-4225-9528-\
1e4696324053"],

