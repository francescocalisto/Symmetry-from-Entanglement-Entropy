Cell[CellGroupData[{

Cell["8. Inspect and cluster the solutions", "Section",ExpressionUUID->"30022310-874c-4675-9218-46d12c017afe"],

Cell["\<\
The diagnostics include the finite Lie-chain residual, the norm of the \
coupling vector, and QNorm = Tr[q.q], where q is the traceless part of tau_ij \
= lambda_ijkk. For the known invariant branches in N=3 and N=4, QNorm should \
vanish after sufficiently strong Lie-chain constraints.\
\>", "Text",ExpressionUUID->"830ab085-da0b-4ae1-b5b1-86be582aebe4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagnostics", " ", "=", " ", 
   RowBox[{"EvaluateDiagnostics", "[", "search", "]"}]}], ";"}], "\n", 
 RowBox[{"Short", "[", 
  RowBox[{"diagnostics", ",", " ", "3"}], "]"}]}], "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"35a9fc26-ecc7-42b0-b37e-7d30afa400c5"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}], "}"}],
  Short[#, 3]& ]], "Output",
