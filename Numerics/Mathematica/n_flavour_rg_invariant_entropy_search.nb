    "lam1123", ",", "lam1124", ",", "lam1133", ",", "lam1134", ",", "lam1144",
    ",", "lam1222", ",", "lam1223", ",", "lam1224", ",", "lam1233", ",", 
   "lam1234", ",", "lam1244", ",", "lam1333", ",", "lam1334", ",", "lam1344", 
