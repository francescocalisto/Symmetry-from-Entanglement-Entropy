Cell[CellGroupData[{

Cell["5. Build the beta functions", "Section",ExpressionUUID->"8b08ff67-3091-4b8f-8564-64c48a1736c2"],

Cell["\<\
BetaVector gives one beta function for each independent symmetric quartic \
component. The convention is beta_ijkl = -epsilon lambda_ijkl + kappa times \
the three one-loop channels. For numerical searches below we set epsilon = \
kappa = 1 by default.\
\>", "Text",ExpressionUUID->"f38769fb-8955-4c06-b547-1db186a75c53"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"betas", " ", "=", " ", 
   RowBox[{"BetaVector", "[", 
    RowBox[{"model", ",", " ", "epsilon", ",", " ", "kappa"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Length", "[", "betas", "]"}]}], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"ff611dd6-b29c-4891-b7e3-5b92657c05ea"],

Cell[BoxData["35"], "Output",
 CellChangeTimes->{
  3.989499923691043*^9, 3.989499987980709*^9, 3.989500119016881*^9, 
   3.9895007826844788`*^9, 3.989501459204432*^9, 3.989501671833705*^9, {
   3.9895019741761713`*^9, 3.989501988510601*^9}, 3.989502401924708*^9, 
   3.9895026834460993`*^9, 3.989504660211813*^9, 3.989505884840124*^9, 
   3.9895066587900763`*^9, {3.989506890867991*^9, 3.989506900734438*^9}, 
   3.989507042470639*^9, 3.989507143803609*^9},
 CellLabel->
  "Out[181]=",ExpressionUUID->"03d8afcc-8788-45d1-8d5b-cc455d6a4c6a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Build the finite Lie chain", "Section",ExpressionUUID->"0486bc59-c0e0-4118-b051-99e1df0b8788"],

Cell["\<\
The infinite RG-invariance condition is T = L_beta T = L_beta^2 T = ... = 0. \
Numerically we impose this only up to maxLieOrder. This cell constructs those \
polynomial equations explicitly.\
\>", "Text",ExpressionUUID->"5e1b662a-12c3-406d-8c54-e8591c1eaa03"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"lieChainEqs", " ", "=", " ", 
  RowBox[{"LieChainEquations", "[", 
   RowBox[{"maxEntropyEqs", ",", " ", 
    RowBox[{"model", "[", "\"\<Variables\>\"", "]"}], ",", " ", "betas", ",", 
    " ", "maxLieOrder"}], "]"}]}], "\n", 
 RowBox[{"Length", "[", "lieChainEqs", "]"}]}], "Input",
 CellChangeTimes->{{3.9895008005338793`*^9, 3.989500812479056*^9}, 
   3.989507833571948*^9},
