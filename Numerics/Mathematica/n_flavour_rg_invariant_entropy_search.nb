   3.989506998145507*^9, 3.989507135052042*^9},
 CellLabel->
  "Out[173]=",ExpressionUUID->"67b99e19-09eb-498b-8c4f-a4604cdbd005"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Compute the maximal 1|3 entropy locus M_{1|3}", "Section",ExpressionUUID->"add5a7de-e58c-429d-b257-83bb7a9e632e"],

Cell["\<\
The matrix R has entries R_ij = Sum lambda[i,a,b,c] lambda[j,a,b,c]. The \
entropy is maximal when the traceless part T = R - Tr[R] Identity/N vanishes. \
The list maxEntropyEqs is the polynomial equation set defining M_{1|3}.\
\>", "Text",ExpressionUUID->"d81bc6c5-e761-4308-9cb5-e0b6e51d9fcc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"entropyData", " ", "=", " ", 
   RowBox[{"MaxEntropyData", "[", "model", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rmatrix", " ", "=", " ", 
   RowBox[{"entropyData", "[", "\"\<RMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Tmatrix", " ", "=", " ", 
   RowBox[{"entropyData", "[", "\"\<TMatrix\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxEntropyEqs", " ", "=", " ", 
   RowBox[{"entropyData", "[", "\"\<Equations\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "maxEntropyEqs", "]"}]}], "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"87962068-6ee3-42b1-aa73-d4ea5055bb5a"],

Cell[BoxData["9"], "Output",
 CellChangeTimes->{
